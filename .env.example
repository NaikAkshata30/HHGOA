# FrameInGoa — Frame for Goa 2026 Builder Identity
#
# Copy to `.env.local` and set your real values. NEVER commit real secrets.
#
# VITE_SITE_URL — your canonical PUBLIC production URL. Encoded into every
# Builder ID QR and used for the share link. Must be publicly reachable from a
# phone (no localhost / 127.0.0.1). When not set, the QR falls back to the
# current page origin (correct on the deployed site, wrong on localhost dev).
VITE_SITE_URL=https://your-production-domain.com

# Legacy alias for the X/Twitter share link (also used by the QR if
# VITE_SITE_URL is not set). Keep in sync with VITE_SITE_URL.
# VITE_APP_URL=https://your-production-domain.com